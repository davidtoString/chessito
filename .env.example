# Run node docker/setup.mjs to generate a private .env with a random password.
CHESSITO_USERNAME=david
CHESSITO_PASSWORD=replace-with-a-long-unique-password
CHESSITO_PORT=3000
CHESSITO_BIND_ADDRESS=127.0.0.1
# For production HTTPS, set a domain pointing to your Docker host:
# CHESSITO_DOMAIN=chess.example.com
# For an existing reverse proxy:
# CHESSITO_PUBLIC_ORIGIN=https://chess.example.com
# The owner account is created from the two values above on first start, then managed in Settings.
# Friends join through invite links you create in Settings. Set to "closed" to stop new accounts.
# CHESSITO_SIGNUP=invite
# Email through Resend (https://resend.com): password reset, invites by email, address confirmation.
# Leave blank to keep these features off. The sender must use a domain verified in Resend.
# RESEND_API_KEY=re_xxxxxxxx
# CHESSITO_EMAIL_FROM="Chessito <chess@your-verified-domain.com>"
