# Run node docker/setup.mjs to generate a private .env with a random password.
CHESSITO_USERNAME=david
CHESSITO_PASSWORD=replace-with-a-long-unique-password
CHESSITO_PORT=3000
CHESSITO_BIND_ADDRESS=127.0.0.1
# For production HTTPS, set a domain pointing to your Docker host:
# CHESSITO_DOMAIN=chess.example.com
# For an existing reverse proxy:
# CHESSITO_PUBLIC_ORIGIN=https://chess.example.com
